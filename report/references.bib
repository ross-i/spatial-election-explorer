@Book{spatial,
publisher={Cambridge University Press},
series={Cambridge Books},
author={Enelow,James M. and Hinich,Melvin J.},
title={The Spatial Theory of Voting},
year={1984},
month={Enero-Abr},
number={9780521275156},
abstract={This book provides an introduction to an important approach to the study of voting and elections: the spatial theory of voting. In contrast to the social-psychological approach to studying voting behaviour, the spatial theory of voting is premised on the idea of self-interested choice. Voters cast votes on the basis of their evaluation of the candidates or policy alternatives competing for their vote. Candidates fashion their appeals to the voters in an effort to win votes. The spatial theory provides explicit definitions for these behavioural assumptions to determines the form that self-interested behaviour will take. The consequences of this behaviour for the type of candidate or policy that voters will select is the major focus of the theory. There is a twofold purpose to this work. The first is to provide an elementary but rigourous introduction to an important body of political science research. The second is to design and test a spatial theory of elections that provides insights into the nature of election contests. The book will appeal to a wide audience, since the mathematics is kept to an accessible level.},
keywords={},
url={https://ideas.repec.org/b/cup/cbooks/9780521275156.html},
}

